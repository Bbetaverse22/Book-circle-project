# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_claude_key
OPENAI_API_KEY=your_whisper_key
ELEVENLABS_API_KEY=your_elevenlabs_key
PORT=3000

# ── Optional: subscriptions ─────────────────────────────────────────────────
# RevenueCat secret API key (starts with "sk_"). Without it, every device is
# treated as free tier.
REVENUECAT_API_KEY=
# Entitlement identifier configured in the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID=premium

# ── Optional: usage limits ──────────────────────────────────────────────────
FREE_QUESTIONS_PER_DAY=3
SUBSCRIBER_QUESTIONS_PER_DAY=200

# ── Optional: Firestore usage tracking ──────────────────────────────────────
# On Cloud Run, credentials and project are auto-detected — leave these unset.
# Locally, set FIREBASE_PROJECT_ID plus GOOGLE_APPLICATION_CREDENTIALS to test
# against real Firestore; otherwise an in-memory store is used.
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
