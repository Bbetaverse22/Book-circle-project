# Use localhost for iOS Simulator / web. On a physical phone, Expo will
# auto-detect your computer's IP when this is left as localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

# RevenueCat public Apple API key (starts with "appl_"). Optional in dev —
# without it the paywall shows an "App Store version" notice instead of
# purchase buttons. Required for production builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# RevenueCat entitlement identifier (must match the dashboard + backend).
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
