{
  "expo": {
    "name": "BookCircle",
    "slug": "bookcircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bookcircle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "BookCircle needs microphone access to record your voice for chat."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bookcircle.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.bookcircle.app",
      "versionCode": 1
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
